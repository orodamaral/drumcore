# PlatformIO
firmware/.pio/
firmware/.vscode/.browse.c_cpp.db*
firmware/.vscode/c_cpp_properties.json
firmware/.vscode/launch.json
firmware/.vscode/ipch

# Desktop app (Electron + React/TypeScript, ver desktop-app/README.md)
desktop-app/node_modules/
desktop-app/out/
desktop-app/dist/
desktop-app/build/

# App web (Vite puro, reusa componentes de desktop-app/src/renderer/src -
# ver web-app/vite.config.ts). Build publicado em site/app/ pelo CI, nunca
# commitado aqui.
web-app/node_modules/
web-app/dist/

# Sistema
.DS_Store
Thumbs.db
*.log

# KiCad - historico automatico de algum plugin/editor (nao e' historico
# de projeto de verdade, e por algum motivo vem com seu proprio .git
# aninhado dentro) - ver docs/01-decisoes-arquiteturais.md se isso virar
# relevante de novo.
**/.history/

# Nunca versionar arquivos de torrent/distribuicao de software.
*.torrent

# MCP config e locks de editor - especificos da maquina/sessao local
.mcp.json
hardware/**/~*.lck
